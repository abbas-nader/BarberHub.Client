<Modal IsOpen="IsOpen" Title="@Title" OnClose="OnCancel">
    <ChildContent>
        <p class="confirm-text">@Message</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="OnCancel" disabled="@busy">انصراف</button>
        <button class="btn @(Danger ? "btn-danger" : "btn-primary")" @onclick="Confirm" disabled="@busy">
            @(busy ? "صبر کنید…" : ConfirmText)
        </button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "تایید";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "تایید";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool busy;

    private async Task Confirm()
    {
        busy = true;
        try { await OnConfirm.InvokeAsync(); }
        finally { busy = false; }
    }
}
